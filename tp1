    ul, ol { padding-left: 20px; }
    li { margin-bottom: 5px; line-height: 1.6; color: #444; }
 
    /* TABLEAU */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    th {
      background: #1a1a2e;
      color: white;
      padding: 10px 14px;
      text-align: left;
    }
    td {
      padding: 10px 14px;
      border-bottom: 1px solid #eee;
      vertical-align: top;
    }
    tr:hover td { background: #f9f9f9; }
 
    /* RÉSEAUX SOCIAUX */
    .reseaux { display: flex; gap: 15px; flex-wrap: wrap; }
    .reseaux a {
      display: inline-block;
      background: #1a1a2e;
      color: white;
      padding: 10px 20px;
      border-radius: 5px;
      text-decoration: none;
      font-size: 0.9rem;
      transition: background 0.2s;
    }
    .reseaux a:hover { background: #00d4ff; color: #1a1a2e; }
 
    /* FOOTER */
