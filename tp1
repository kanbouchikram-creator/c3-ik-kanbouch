      display: flex;
      gap: 25px;
      align-items: flex-start;
    }
    .apropos-contenu img {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 3px solid #00d4ff;
      object-fit: cover;
      flex-shrink: 0;
    }
 
    /* Placeholder photo */
    .photo-placeholder {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 3px solid #00d4ff;
      background: #e8f4ff;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #90b8d8;
      font-size: 0.72rem;
      text-align: center;
      gap: 6px;
    }
    .photo-placeholder svg { opacity: 0.5; }
 
    .apropos-contenu p { line-height: 1.7; color: #444; margin-bottom: 8px; }
 
    /* COMPÉTENCES */
    .competences-grille {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .competences-grille h4 {
      color: #1a1a2e;
      margin-bottom: 8px;
      font-size: 0.95rem;
